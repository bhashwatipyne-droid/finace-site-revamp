# Public site URL (used for social-share metadata)
NEXT_PUBLIC_SITE_URL=https://finace.co

# Supabase: Project Settings → API Keys. The publishable key is enough: it can
# only call submit_website_brief, which inserts one brief and reads nothing.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
